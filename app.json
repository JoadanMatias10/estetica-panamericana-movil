{
  "expo": {
    "name": "Estética Panamericana",
    "slug": "estetica-panamericana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "esteticapanamericana",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/brand-icon.png"
    },
    "android": {
      "package": "com.esteticapanamericana.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9FC",
        "foregroundImage": "./assets/images/brand-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9FC",
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "77956905746-t0oogo2d4qjnshumvq41393e2pbv0d0f.apps.googleusercontent.com"
    }
  }
}